# ---------------------------------------------------------------------------
# Marketer Activity Tool — environment variables
# ---------------------------------------------------------------------------

# Base URL of the iPrescribe API, including the /api prefix.
# Local Laravel dev server:  http://127.0.0.1:8000/api
# Staging:                   https://<your-api-host>/api
#
# This is the only variable the app needs. It is read in the browser, so it must
# be NEXT_PUBLIC_*; nothing secret is ever sent from here — the Google key, the
# database and the Passport tokens all live on the API side.
NEXT_PUBLIC_API_BASE_URL="http://127.0.0.1:8000/api"

# Optional UI label
NEXT_PUBLIC_APP_NAME="Marketer Activity Tool"
