# ---------------------------------------------------------------------------
# Marketer Activity Tool — environment variables
#
# The current build is FRONTEND-ONLY with mocked auth and mocked data, so none
# of these are required to run `pnpm dev` today. They are documented here so the
# backend phases (Prisma, Auth.js, Google geocoding) can be wired in later
# without rediscovering what is needed.
# ---------------------------------------------------------------------------

# Postgres (Neon) — pooled connection used by the app at runtime
DATABASE_URL="postgresql://user:password@host/db?sslmode=require&pgbouncer=true"

# Postgres (Neon) — direct connection used by `prisma migrate`
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# Auth.js v5
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"

# Timezone that defines "today" / "this week" across the app
APP_TIMEZONE="Africa/Lagos"

# Reverse geocoding (server-side only)
GEOCODING_PROVIDER="google"
GEOCODING_API_KEY="your-google-geocoding-api-key"

# First admin, used only by prisma/seed.ts
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-after-first-login"

# Optional UI label
NEXT_PUBLIC_APP_NAME="Marketer Activity Tool"
