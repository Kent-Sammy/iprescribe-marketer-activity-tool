# ---------------------------------------------------------------------------
# Marketer Activity Tool — environment variables
# ---------------------------------------------------------------------------

# ===== Authentication (Clerk) — REQUIRED =====
# From the Clerk dashboard -> API keys. The app will not build or run without
# these. Use the pk_test_/sk_test_ pair for local + preview, and the pk_live_/
# sk_live_ pair for the production environment on Vercel.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxx"
CLERK_SECRET_KEY="sk_test_xxx"

# Keep Clerk's built-in helpers pointed at our custom /login page.
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/login"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/login"

# ===== Data backend (not built yet — for later phases) =====

# Postgres (Neon) — pooled connection used by the app at runtime
DATABASE_URL="postgresql://user:password@host/db?sslmode=require&pgbouncer=true"

# Postgres (Neon) — direct connection used by `prisma migrate`
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# Timezone that defines "today" / "this week" across the app
APP_TIMEZONE="Africa/Lagos"

# Reverse geocoding (server-side only)
GEOCODING_PROVIDER="google"
GEOCODING_API_KEY="your-google-geocoding-api-key"

# Optional UI label
NEXT_PUBLIC_APP_NAME="Marketer Activity Tool"

# NOTE: admin accounts are created in the Clerk dashboard (invite/create a user,
# then set publicMetadata to {"role":"admin"}). There is no admin seed script and
# no public admin sign-up.
